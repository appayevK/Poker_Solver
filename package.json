{
  "name": "poker-solver",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-based NLHE study tool: hand review, preflop, EV/ICM/PKO and Nash push/fold",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:equity": "node scripts/build-equity-table.js",
    "bench": "node scripts/bench-evaluator.js",
    "flops:subset": "node scripts/flops/build-subset.js",
    "flops:configs": "node scripts/flops/make-configs.js",
    "flops:bench": "node scripts/flops/make-configs.js --limit 1 && node scripts/flops/run-solves.js --bench",
    "flops:solve": "node scripts/flops/run-solves.js",
    "flops:extract": "node scripts/flops/extract.js && node scripts/flops/build-index.js",
    "flops:all": "node scripts/flops/make-configs.js && node scripts/flops/run-solves.js && node scripts/flops/extract.js && node scripts/flops/build-index.js"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.5",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
